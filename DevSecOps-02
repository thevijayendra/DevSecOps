-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
Secure Dockerfile:
# ===== Stage 1: Builder =====
FROM python:3.11-slim AS builder

RUN apt update && apt install -y --no-install-recommends \
    gcc git

WORKDIR /app
RUN pip install --no-cache-dir --target=/install flask
COPY app.py .

# ===== Stage 2: Final runtime (Distroless) =====
FROM gcr.io/distroless/python3-debian12

WORKDIR /app

COPY --from=builder --chown=65532:65532 /install /app/deps
COPY --from=builder --chown=65532:65532 /app/app.py .

ENV PYTHONPATH=/app/deps

USER 65532
EXPOSE 5000
CMD ["app.py"]

