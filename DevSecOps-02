def check_environment():
    checks = []

    # 1. Build secret
    secret = os.getenv("BUILD_SECRET")
    if secret:
        checks.append({
            "name": "Build Secret present",
            "result": secret[:20] + "..." if len(secret) > 20 else secret,
            "status": "bad",
            "risk": "High – Secret leaked"
        })
    else:
        checks.append({
            "name": "Build Secret present",
            "result": "Not found",
            "status": "good",
            "risk": "Safe"
        })

    # 2. gcc
    gcc = shutil.which("gcc")
    checks.append({
        "name": "Compiler (gcc) present",
        "result": gcc if gcc else "Not found",
        "status": "bad" if gcc else "good",
        "risk": "High" if gcc else "Safe"
    })

    # 3. git
    git = shutil.which("git")
    checks.append({
        "name": "Git present",
        "result": git if git else "Not found",
        "status": "bad" if git else "good",
        "risk": "Medium" if git else "Safe"
    })

    # 4. apt / package manager
    apt = shutil.which("apt-get") or shutil.which("apt")
    checks.append({
        "name": "Package manager (apt)",
        "result": apt if apt else "Not found",
        "status": "bad" if apt else "good",
        "risk": "High" if apt else "Safe"
    })

    return checks

@app.route("/")
def home():
    checks = check_environment()
    return render_template_string(PAGE, checks=checks)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
